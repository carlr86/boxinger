# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # https://www.boxinger.com en producción

# ── Supabase (Project Settings › API) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                        # solo servidor: webhooks, cron, emails, admin

# ── Email (Resend) ──
RESEND_API_KEY=                                   # sin clave, los emails se loguean en consola
EMAIL_FROM="Boxinger <hola@boxinger.com>"
EMAIL_REPLY_TO=hola@boxinger.com

# ── Formulario de contacto (casilla de Hostinger, hPanel › Emails) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@boxinger.com
SMTP_PASS=                                        # contraseña de la casilla
# CONTACT_TO=hola@boxinger.com                    # opcional; por defecto SMTP_USER

# ── PayPal (developer.paypal.com › Apps & Credentials) ──
PAYPAL_ENV=sandbox                                # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                                # id del webhook creado en la app de PayPal
# PAYPAL_PRODUCT_ID=                              # opcional; si falta se crea solo

# ── Mercado Pago (mercadopago.com.ar/developers › Tus integraciones) ──
MP_ACCESS_TOKEN=                                  # APP_USR-… (o TEST-… en pruebas)
MP_WEBHOOK_SECRET=                                # "Clave secreta" de la sección Webhooks

# ── Cron (GitHub Actions lo manda como Authorization: Bearer …) ──
CRON_SECRET=
