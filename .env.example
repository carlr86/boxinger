# ── App ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # https://www.boxinger.com en producción

# ── Supabase (Project Settings › API) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                        # solo servidor: webhooks, cron, emails, admin

# ── Email (Resend) ──
RESEND_API_KEY=                                   # sin clave, los emails se loguean en consola
EMAIL_FROM="Boxinger <hola@boxinger.com>"
EMAIL_REPLY_TO=hola@boxinger.com

# ── Formulario de contacto (casilla de Hostinger, hPanel › Emails) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hola@boxinger.com
SMTP_PASS=                                        # contraseña de la casilla
# CONTACT_TO=hola@boxinger.com                    # opcional; por defecto SMTP_USER

# ── PayPal (developer.paypal.com › Apps & Credentials) ──
PAYPAL_ENV=sandbox                                # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                                # id del webhook creado en la app de PayPal
# PAYPAL_PRODUCT_ID=                              # opcional; si falta se crea solo

# ── Creem (pagos internacionales en USD; creem.io › Developers) ──
CREEM_API_KEY=                                    # creem_test_… en pruebas, creem_… en producción
CREEM_PRODUCT_ID=                                 # producto "Plan Pro" mensual USD 9,99 (prod_…)
CREEM_WEBHOOK_SECRET=                             # secreto del webhook (se crea por API)
NEXT_PUBLIC_CREEM_ENABLED=1                       # muestra "Tarjeta internacional" en Pasar a Pro

# ── Asistente IA, plan Enterprise (console.anthropic.com › API Keys) ──
ANTHROPIC_API_KEY=                                # sin esta clave el asistente avisa que no está configurado
# ANTHROPIC_MODEL=claude-sonnet-5-5               # opcional; con otro modelo, ajustá los precios de abajo
# AI_PRICE_IN_USD=3                               # USD por millón de tokens de entrada (para el costo en Admin)
# AI_PRICE_OUT_USD=15                             # USD por millón de tokens de salida

# ── Mercado Pago (mercadopago.com.ar/developers › Tus integraciones) ──
MP_ACCESS_TOKEN=                                  # APP_USR-… (o TEST-… en pruebas)
MP_WEBHOOK_SECRET=                                # "Clave secreta" de la sección Webhooks

# ── Cron (GitHub Actions lo manda como Authorization: Bearer …) ──
CRON_SECRET=
